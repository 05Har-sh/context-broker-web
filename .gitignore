# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (strict ignore for all secrets & envs, allow only example)
.env*
!.env.example

# secrets, keys & certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
*.pub

# IDE & Editor settings
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db

# Prototype & scratch static exports (HTML previews)
*.html
!public/**/*.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

